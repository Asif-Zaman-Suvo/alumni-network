# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# DATABASE_URL must be the POOLED connection (pgbouncer, port 6543) — the app
# runtime opens many short-lived connections and would exhaust a direct pool.
# DIRECT_URL must be the DIRECT connection (port 5432) because Prisma Migrate
# needs session-level features that pgbouncer's transaction mode does not offer.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# connection_limit=1 is correct for many serverless isolates. For a single `next dev`
# process you may raise it (e.g. 5) so Promise.all can overlap. Production Vercel: keep 1.

# ---------------------------------------------------------------------------
# Auth.js v5 (note: AUTH_* names, not the v4 NEXTAUTH_* names)
# Generate the secret with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=""
# Only required when the deployment URL cannot be inferred (e.g. behind a proxy).
# AUTH_URL="http://localhost:3000"

# Google OAuth — optional. Leave blank to disable the Google button.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook OAuth — optional. Leave blank to disable the Facebook button.
# App dashboard: add Valid OAuth Redirect URI
#   {AUTH_URL or NEXT_PUBLIC_APP_URL}/api/auth/callback/facebook
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# ---------------------------------------------------------------------------
# Supabase Storage
# The service role key is server-only and must never be exposed to the client.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_CERTIFICATE_BUCKET="verification-documents"
SUPABASE_AVATAR_BUCKET="avatars"

# ---------------------------------------------------------------------------
# Authentication audit log
# Keys the HMAC that pseudonymises the email address on a failed sign-in, so the
# table never becomes an enumerable list of which accounts exist. Required.
# Generate with: openssl rand -base64 32
# Rotating it means older failed-login hashes no longer correlate with newer ones.
# ---------------------------------------------------------------------------
AUDIT_HASH_SECRET=""

# ---------------------------------------------------------------------------
# Realtime audit monitoring — optional. Without SUPABASE_REALTIME_JWK the admin
# audit page still works as a paginated history, just without live updates.
#
# This app does not use Supabase Auth, so there is no Supabase-issued JWT to
# present when subscribing. Instead we sign our own short-lived ES256 tokens with
# a key Supabase also holds, so Supabase can verify what we signed:
#   1. Generate an EC P-256 key pair as a JWK, including a "kid".
#   2. Dashboard → Authentication → JWT Keys → import the PRIVATE JWK. Supabase
#      needs the private key, not the public half: it stores the pair and serves
#      the public half at /auth/v1/.well-known/jwks.json for verification.
#   3. Rotate so the imported key becomes CURRENT. A STANDBY key is published but
#      not yet trusted for incoming tokens, so joins fail until it is rotated in.
#   4. Put the same PRIVATE JWK here, minified onto one line. The "kid" must match
#      the one imported above or Supabase cannot select the key.
#   5. Disable public channel access in Dashboard → Realtime → Settings.
# Keep this server-only; it is as sensitive as AUTH_SECRET.
# ---------------------------------------------------------------------------
SUPABASE_REALTIME_JWK=""
# Deliberately short: this is the window in which a just-revoked administrator
# could still hold a working channel token. 60–3600 seconds.
SUPABASE_REALTIME_JWT_TTL_SECONDS="600"

# ---------------------------------------------------------------------------
# Vercel Cron — optional. Secures /api/cron/expire-sessions, which writes the
# SESSION_EXPIRED audit events. Access control already rejects expired sessions
# without this, so a missing secret delays the record rather than the enforcement.
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Transactional email (Brevo). Optional in development: without a key, emails
# are logged to the console instead of being sent.
# Verify the sender in Brevo → Senders (no custom domain required). Set the
# same vars on Vercel. NEXT_PUBLIC_APP_URL must be the production origin so
# reset links in Gmail work.
# ---------------------------------------------------------------------------
BREVO_API_KEY=""
EMAIL_FROM="Alumni Network <your-verified-sender@gmail.com>"

# ---------------------------------------------------------------------------
# Seed (prisma/seed.ts). Not read by the Next.js app.
# ---------------------------------------------------------------------------
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SCHOOL_NAME="Our School"
