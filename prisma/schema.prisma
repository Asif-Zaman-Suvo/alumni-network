// Alumni network schema.
//
// Three things in here cannot be expressed by Prisma and are created by hand in
// prisma/migrations/0_init/migration.sql:
//   1. Profile.searchVector as a GENERATED ALWAYS ... STORED tsvector column + GIN index
//   2. The pg_trgm extension and a trigram index on Profile.displayName
//   3. Partial unique indexes on VerificationRequest (sscRoll, sscRegistration) for VERIFIED and PENDING — year is not part of identity
//
// prisma/migrations/20260813120000_auth_audit_realtime/migration.sql adds three more:
//   4. A partial unique index making session lifecycle audit events idempotent
//   5. app_private.broadcast_audit_log(), a trigger that pushes sanitised audit
//      notifications onto a private Supabase Realtime channel
//   6. app_private.can_read_audit_stream(), the SECURITY DEFINER predicate behind the
//      realtime.messages RLS policy for that channel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (pgbouncer, port 6543) used by the application runtime.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432); Prisma Migrate cannot run through pgbouncer.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  ALUMNI
}

enum UserStatus {
  /// Account created, SSC details not submitted yet.
  UNVERIFIED
  /// SSC details submitted, waiting on an admin decision.
  PENDING
  /// Approved by an admin. Only this status can read alumni data.
  VERIFIED
  /// Rejected by an admin, may resubmit.
  REJECTED
}

enum Visibility {
  /// Visible to anyone, including signed-out visitors.
  PUBLIC
  /// Visible only to verified alumni.
  MEMBERS_ONLY
  /// Visible only to the owner and admins.
  PRIVATE
}

enum Gender {
  MALE
  FEMALE
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerified   DateTime?
  passwordHash    String?
  role            Role       @default(ALUMNI)
  status          UserStatus @default(UNVERIFIED)
  /// False until WhatsApp phone is saved (required after admin approval).
  profileComplete Boolean    @default(false)
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile       Profile?
  verifications VerificationRequest[]
  reviewed      VerificationRequest[] @relation("ReviewedBy")
  accounts      Account[]
  sessions      Session[]
  authSessions  AuthSession[]
  auditLogs     AuditLog[]
  resetTokens   PasswordResetToken[]

  @@index([status])
  @@index([role])
}

/// One row per submission attempt. Rejected attempts are kept so the admin has history
/// and the user can see why they were turned down.
model VerificationRequest {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sscRoll         String
  sscRegistration String
  passingYear     Int
  fullNameOnCert  String
  /// Object path inside the private Supabase Storage bucket. Signed on read, never public.
  documentPath    String?
  status          UserStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?      @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Required when rejecting. Surfaced to the user on their status page.
  reviewNote      String?
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())

  @@index([status, createdAt])
  @@index([passingYear])
  @@index([userId, createdAt])
  @@index([sscRoll, sscRegistration, passingYear])
  // Partial uniques live in SQL migrations — identity is roll + registration (year is not part of uniqueness):
  // - VerificationRequest_ssc_verified_key (status = VERIFIED)
  // - VerificationRequest_ssc_pending_key (status = PENDING)
}

model Department {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  sortkey  Int       @default(0)
  profiles Profile[]
}

model Profile {
  id             String     @id @default(cuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String     @unique
  displayName    String
  headline       String?
  bio            String?
  avatarUrl      String?
  gender         Gender?
  /// When true, directory and public profile may show gender.
  showGender     Boolean    @default(false)
  /// Optional. Visible on directory cards and profiles whenever set.
  bloodGroup     BloodGroup?

  graduationYear Int?
  degree         String?
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  company        String?
  position       String?
  /// WhatsApp-capable mobile number. Required before directory access after approval.
  whatsappPhone  String?
  linkedInUrl    String?
  facebookUrl    String?
  websiteUrl     String?

  city           String?
  /// ISO 3166-1 alpha-2. A controlled vocabulary keeps the country facet usable.
  countryCode    String?    @db.Char(2)

  collegeName         String?
  collegeDepartment   String?
  /// Academic session label, e.g. 2018-19.
  collegeSession      String?
  /// HSC / intermediate passing year (college).
  hscPassingYear      Int?
  universityName      String?
  universityDepartment String?
  universitySession   String?

  visibility     Visibility @default(MEMBERS_ONLY)
  showEmail      Boolean    @default(false)
  showEmployer   Boolean    @default(true)

  /// Generated column maintained by Postgres; see the init migration. Prisma never writes it.
  searchVector   Unsupported("tsvector")?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([graduationYear])
  @@index([departmentId])
  @@index([countryCode])
  @@index([visibility])
  @@index([bloodGroup])
}

/// Append-only history for staff mutations AND authentication lifecycle events.
///
/// Everything except `action` and `createdAt` is nullable because the table has to record
/// events that have no actor row: a failed sign-in for an address that was never registered
/// still has to leave a trace. `actorId` is SetNull rather than Cascade so deleting a user
/// cannot silently erase what that user did.
model AuditLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Immutable copy of the actor's email at write time. Survives actor deletion and email changes.
  actorEmail String?
  actorRole  Role?
  action     String
  targetType String?
  targetId   String?

  /// AuthSession.id. Deliberately not a foreign key: session rows are operational state with
  /// their own lifecycle, and an audit row must never be mutated or removed by that lifecycle.
  sessionId String?
  /// "credentials", "google", "facebook", or "system" for machine-initiated events.
  provider  String?
  /// Keyed HMAC of the submitted address. Lets an operator correlate repeated failed sign-ins
  /// without the table itself becoming a list of addresses that exist.
  subjectHash String?
  /// Coarse machine-readable cause, e.g. "invalid_credentials". Never a raw error message.
  reason      String?
  ipAddress   String?
  userAgent   String?

  metadata  Json?
  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
  /// Keyset pagination: createdAt alone is not unique enough to be a stable cursor.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([sessionId])
  // A partial unique index enforcing one terminal event per session lives in SQL:
  // - AuditLog_session_lifecycle_key
}

enum AuthSessionStatus {
  /// Issued and not yet ended. The only status that may access the application.
  ACTIVE
  /// Ended by the user.
  LOGGED_OUT
  /// Passed `expiresAt` and was reaped by the expiry job.
  EXPIRED
  /// Ended by suspension, password reset, account closure, or an administrator.
  REVOKED
}

/// Server-side registry of issued sessions.
///
/// Auth.js runs a stateless JWT strategy, which cannot express "this session was revoked
/// three seconds ago" — the cookie stays cryptographically valid until it expires. This table
/// is the authority the DAL checks on every request, so revocation takes effect immediately.
/// Distinct from the `Session` model below, which belongs to the Auth.js adapter and is unused
/// under the JWT strategy.
model AuthSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status   AuthSessionStatus @default(ACTIVE)
  provider String

  ipAddress String?
  userAgent String?

  issuedAt  DateTime @default(now())
  /// Mirrors the JWT `maxAge` so the expiry job and the cookie agree on the same instant.
  expiresAt DateTime
  endedAt   DateTime?
  /// Coarse cause when status is REVOKED, e.g. "account_suspended".
  endedReason String?

  @@index([userId, issuedAt(sort: Desc)])
  /// Drives the expiry sweep: find ACTIVE rows past expiresAt.
  @@index([status, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token. The plaintext only ever exists in the email link.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Database-backed rate limiting. Postgres is already a dependency, so this avoids adding
/// Redis for the handful of endpoints that need throttling at this scale.
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}

// ---------------------------------------------------------------------------
// Auth.js (@auth/prisma-adapter) tables
// ---------------------------------------------------------------------------

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
